{
  "expo": {
    "name": "MyMoney",
    "slug": "mymoney",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "bundleIdentifier": "com.srinikc.mymoney",
      "buildNumber": "1",
      "infoPlist": {
        "NSFaceIDUsageDescription": "MyMoney uses Face ID to securely lock the app.",
        "NSCameraUsageDescription": "Used to scan QR codes for session sharing and receipt OCR.",
        "NSPhotoLibraryUsageDescription": "Used to upload receipt images for expense tracking.",
        "NSMicrophoneUsageDescription": "MyMoney uses the microphone for voice commands to log expenses, income, and ask financial questions."
      }
    },
    "android": {
      "package": "com.srinikc.mymoney",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "expo-local-authentication",
      "expo-notifications",
      "expo-speech-recognition",
      "expo-audio"
    ],
    "extra": {
      "eas": {
        "projectId": "005bb0a4-47ab-4770-9ccc-1fc5bca5297b"
      }
    },
    "scheme": "mymoney",
    "platforms": [
      "ios",
      "android"
    ]
  }
}

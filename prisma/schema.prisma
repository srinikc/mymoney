generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth & Multi-Profile ──────────────────────────────────────────────

model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  name      String?
  image     String?
  role      String    @default("user") // user | admin | manager | viewer
  tier      String    @default("free") // free | pro | premium
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profiles  Profile[]
  accounts  Account[]
  sessions  Session[]
}

model Profile {
  id        Int      @id @default(autoincrement())
  name      String
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations to all data tables
  expenses    Expense[]
  budgets     Budget[]
  goals       Goal[]
  investments Investment[]
  plans       Plan[]
  reminders   Reminder[]
  deals       Deal[]
  assets      Asset[]
  liabilities Liability[]
  auditLogs   AuditLog[]
}

model Account {
  id                Int      @id @default(autoincrement())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           Int      @id @default(autoincrement())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model FeatureFlag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  enabled   Boolean  @default(false)
  tier      String   @default("free") // free | pro | premium
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  profileId Int
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  action    String   // create | update | delete | view | export | import
  entity    String   // expense | budget | goal | etc.
  entityId  Int?
  metadata  String?  // JSON string with extra context
  createdAt DateTime @default(now())

  @@index([profileId])
  @@index([action])
  @@index([entity])
  @@index([createdAt])
}

// ── Categories ────────────────────────────────────────────────────────

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  type      String    @default("expense")
  icon      String    @default("circle")
  color     String    @default("#6366f1")
  createdAt DateTime  @default(now())
  expenses  Expense[]
  budgets   Budget[]
  reminders Reminder[]
}

// ── Expense ───────────────────────────────────────────────────────────

model Expense {
  id              Int             @id @default(autoincrement())
  date            DateTime
  amount          Float
  categoryId      Int
  category        Category        @relation(fields: [categoryId], references: [id])
  subCategory     String?
  person          String?
  vendor          String?
  description     String?
  paymentMode     String          @default("UPI")
  recurrenceType  String          @default("onetime")
  otherType       String?
  tags            String?
  receiptUrl      String?
  isShared        Boolean         @default(false)
  sharedWith      String?
  paidThrough     String?
  bankAccount     String?
  notes           String?
  importSessionId Int?
  importSession   ImportSession?  @relation(fields: [importSessionId], references: [id])
  flagged         Boolean         @default(false)
  profileId       Int?
  profile         Profile?        @relation(fields: [profileId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([date])
  @@index([categoryId])
  @@index([vendor])
  @@index([person])
  @@index([importSessionId])
  @@index([profileId])
}

// ── Budget ────────────────────────────────────────────────────────────

model Budget {
  id         Int      @id @default(autoincrement())
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  month      Int
  year       Int
  amount     Float
  profileId  Int?
  profile    Profile? @relation(fields: [profileId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, month, year])
  @@index([categoryId])
  @@index([profileId])
}

// ── Goal ──────────────────────────────────────────────────────────────

model Goal {
  id            Int      @id @default(autoincrement())
  name          String
  targetAmount  Float
  currentAmount Float    @default(0)
  deadline      DateTime?
  category      String   @default("savings")
  notes         String?
  status        String   @default("active")
  profileId     Int?
  profile       Profile? @relation(fields: [profileId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([profileId])
}

// ── Investment ────────────────────────────────────────────────────────

model Investment {
  id             Int      @id @default(autoincrement())
  type           String
  name           String
  amount         Float
  currentValue   Float
  purchaseDate   DateTime
  returnRate     Float?
  notes          String?
  status         String   @default("active")
  profileId      Int?
  profile        Profile? @relation(fields: [profileId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([profileId])
}

// ── Plan ──────────────────────────────────────────────────────────────

model Plan {
  id                  Int      @id @default(autoincrement())
  name                String
  description         String?
  category            String   @default("general")
  amountNeeded        Float
  amountSaved         Float    @default(0)
  monthlyContribution Float?
  deadline            DateTime?
  status              String   @default("active")
  notes               String?
  profileId           Int?
  profile             Profile? @relation(fields: [profileId], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([profileId])
}

// ── Merchant Mapping ──────────────────────────────────────────────────

model MerchantMapping {
  id          Int      @id @default(autoincrement())
  merchantKey String   @unique
  description String?
  expenseType String?
  subCategory String?
  person      String?
  source      String   @default("manual")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([merchantKey])
}

// ── Import Session ────────────────────────────────────────────────────

model ImportSession {
  id           Int       @id @default(autoincrement())
  source       String
  fileName     String?
  totalRows    Int       @default(0)
  autoMapped   Int       @default(0)
  newMerchants Int       @default(0)
  skipped      Int       @default(0)
  status       String    @default("preview")
  createdAt    DateTime  @default(now())
  expenses     Expense[]
}

// ── Reminder ──────────────────────────────────────────────────────────

model Reminder {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  type        String    @default("custom")
  priority    String    @default("normal")
  dueDate     DateTime?
  amount      Float?
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id])
  merchantKey String?
  recurring   String    @default("none")
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  profileId   Int?
  profile     Profile?  @relation(fields: [profileId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([dueDate])
  @@index([isCompleted])
  @@index([categoryId])
  @@index([profileId])
}

// ── Deal ──────────────────────────────────────────────────────────────

model Deal {
  id          Int       @id @default(autoincrement())
  merchant    String
  title       String
  description String?
  discount    String?
  couponCode  String?
  url         String?
  validUntil  DateTime?
  category    String?
  isActive    Boolean   @default(true)
  profileId   Int?
  profile     Profile?  @relation(fields: [profileId], references: [id])
  createdAt   DateTime  @default(now())

  @@index([merchant])
  @@index([isActive])
  @@index([profileId])
}

// ── Asset ─────────────────────────────────────────────────────────────

model Asset {
  id        Int      @id @default(autoincrement())
  name      String
  type      String   @default("other")
  amount    Float
  notes     String?
  profileId Int?
  profile   Profile? @relation(fields: [profileId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
}

// ── Liability ─────────────────────────────────────────────────────────

model Liability {
  id           Int      @id @default(autoincrement())
  name         String
  type         String   @default("other")
  amount       Float
  interestRate Float?
  dueDate      DateTime?
  notes        String?
  profileId    Int?
  profile      Profile? @relation(fields: [profileId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([profileId])
}

// ── Alerts & Notifications ────────────────────────────────────────────

model AlertRule {
  id        Int      @id @default(autoincrement())
  name      String
  type      String
  config    String?
  isEnabled Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationConfig {
  id         Int      @id @default(autoincrement())
  channel    String   @unique
  enabled    Boolean  @default(false)
  config     String?
  alertTypes String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mymoney:password@localhost:5432/mymoney
# TEST_DATABASE_URL=postgresql://mymoney:password@localhost:5432/mymoney_test

# ── Auth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate-a-random-secret
# NEXTAUTH_URL must match the public URL users reach MyMoney at.
# Dev (HTTP):  http://localhost:3005
# Prod (HTTPS): https://mymoney.example.com   <-- ALWAYS https in production
NEXTAUTH_URL=http://localhost:3005

# Google OAuth (required for Google sign-in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend email auth (optional)
AUTH_RESEND_KEY=

# ── Broker Integrations (optional) ─────────────────────────────────────────
# Zerodha (Kite API) — https://kite.trade
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Sharekhan API
SHAREKHAN_API_KEY=
SHAREKHAN_API_SECRET=
SHAREKHAN_ACCESS_TOKEN=

# ── LLM Providers (optional) ──────────────────────────────────────────────
# LLM_PROVIDER: openai (OpenAI-compatible) | claude | local
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI-compatible base URL for free-tier providers:
#   Groq:          https://api.groq.com/openai/v1
#   Cerebras:      https://api.cerebras.ai/v1
#   OpenRouter:    https://openrouter.ai/api/v1   (use model ids like model:free)
#   Hugging Face:  https://router.huggingface.co/v1
# Leave empty to use OpenAI.com directly.
LLM_BASE_URL=
# Local LLMs (provider=local): Ollama or LM Studio endpoint
LOCAL_LLM_ENDPOINT=

# ── Storage (optional, for receipt uploads) ───────────────────────────────
# S3-compatible storage for receipt images
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=mymoney-receipts

# ── HTTPS / TLS (production) ─────────────────────────────────────────────
# Three deployment options are supported. Pick ONE and leave the others blank.
#
# OPTION A — Reverse proxy (Caddy, nginx, Cloudflare) in front of Next.js.
#   No code changes needed. Set the public URL below to https://...
#   Proxy handles TLS termination. Recommended for self-hosted.
#
# OPTION B — Native HTTPS in Next.js (custom server.js with https module).
#   Uncomment the three SSL_* lines below and set them to your certificate files.
#   Use this only if you're not running behind a proxy. See docs/HTTPS_DEPLOYMENT.md.
#
# SSL_KEY_PATH=/etc/letsencrypt/live/mymoney.example.com/privkey.pem
# SSL_CERT_PATH=/etc/letsencrypt/live/mymoney.example.com/fullchain.pem
# HTTPS_PORT=443
#
# OPTION C — Platform TLS (Vercel, Railway, Render, Fly.io, Cloud Run).
#   No env vars needed. The platform provisions and terminates TLS for you.
#   Just set NEXTAUTH_URL and NEXT_PUBLIC_BASE_URL to https://...

# ── Public URL (REQUIRED for production) ──────────────────────────────────
# This is the URL your users visit. Dev: http://localhost:3005
# Prod (all options above): https://your-domain.com
NEXT_PUBLIC_BASE_URL=https://mymoney.example.com
NEXT_PUBLIC_APP_URL=https://mymoney.example.com

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://mymoney:password@localhost:5432/mymoney
# TEST_DATABASE_URL=postgresql://mymoney:password@localhost:5432/mymoney_test

# ── Auth ─────────────────────────────────────────────────────────────────
NEXTAUTH_SECRET=generate-a-random-secret
NEXTAUTH_URL=http://localhost:3005

# Google OAuth (required for Google sign-in)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Resend email auth (optional)
AUTH_RESEND_KEY=

# ── Broker Integrations (optional) ─────────────────────────────────────────
# Zerodha (Kite API) — https://kite.trade
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# Sharekhan API
SHAREKHAN_API_KEY=
SHAREKHAN_API_SECRET=
SHAREKHAN_ACCESS_TOKEN=

# ── LLM Providers (optional) ──────────────────────────────────────────────
# LLM_PROVIDER: openai (OpenAI-compatible) | claude | local
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# OpenAI-compatible base URL for free-tier providers:
#   Groq:          https://api.groq.com/openai/v1
#   Cerebras:      https://api.cerebras.ai/v1
#   OpenRouter:    https://openrouter.ai/api/v1   (use model ids like model:free)
#   Hugging Face:  https://router.huggingface.co/v1
# Leave empty to use OpenAI.com directly.
LLM_BASE_URL=
# Local LLMs (provider=local): Ollama or LM Studio endpoint
LOCAL_LLM_ENDPOINT=

# ── Storage (optional, for receipt uploads) ───────────────────────────────
# S3-compatible storage for receipt images
# STORAGE_PROVIDER=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# S3_BUCKET=mymoney-receipts

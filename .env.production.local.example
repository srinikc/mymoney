# ── Production release secrets (LOCAL ONLY — never committed) ──────────
#
# Copy this file to `.env.production.local` and fill in the real values.
# `.env.production.local` is gitignored; only this `.example` is committed.
# Used only by the manual scripts in `scripts/prod/` (release.ps1 / smoke.ps1).
#
# DB URL: use the Supabase DIRECT connection (port 5432), NOT the pooler
# (port 6543 / ?pgbouncer=true). Migrations need DDL to run.
# Supabase dashboard → project → Settings → Database → Connection string → Direct.

DATABASE_URL=postgresql://postgres:<DB-PASSWORD>@db.<PROJECT-REF>.supabase.co:5432/postgres

# Optional: override the production URL used by smoke checks
PROD_BASE_URL=https://mymoney-mauve.vercel.app
